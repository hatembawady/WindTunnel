{
  "manifest_version": 3,
  "name": "Mercury 2.5 - AI Browser Copilot",
  "version": "1.0.0",
  "description": "وكيل الذكاء الاصطناعي الذاتي داخل الشريط الجانبي لمتصفح كروم لتنفيذ أي مهمة في الويب",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "افتح وكيل Mercury 2.5",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "alarms",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "https://api.inceptionlabs.ai/*",
    "<all_urls>"
  ]
}